{
  "expo": {
    "name": "PlayTracker",
    "slug": "playtracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/playtracker-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#3B0764"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.playtracker.app",
      "splash": {
        "image": "./assets/playtracker-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#3B0764"
      }
    },
    "userInterfaceStyle": "light",
    "scheme": "playtracker",
    "android": {
      "package": "org.playtracker.app",
      "adaptiveIcon": {
        "backgroundColor": "#3B0764",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "splash": {
        "image": "./assets/playtracker-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#3B0764"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "",
      "googleWebClientId": "32346032386-92npa1nj0v043m9qukudbmaa0g0hod1p.apps.googleusercontent.com",
      "googleIosClientId": "",
      "googleAndroidClientId": "",
      "eas": {
        "projectId": "79dba00b-27b1-4813-8f20-a429e2179699"
      }
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "owner": "stacktracker"
  }
}
