{
  "expo": {
    "name": "PlayTracker",
    "slug": "playtracker",
    "version": "1.1.3",
    "assetBundlePatterns": [
      "**/*"
    ],
    "orientation": "portrait",
    "icon": "./assets/PlayTracker-iOS-App-Icon-1024.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#3B0764"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.playtracker.app",
      "buildNumber": "13",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#3B0764"
      }
    },
    "userInterfaceStyle": "light",
    "scheme": "playtracker",
    "newArchEnabled": true,
    "android": {
      "package": "org.playtracker.app",
      "versionCode": 13,
      "versionName": "1.1.3",
      "icon": "./assets/PlayTracker-iOS-App-Icon-1024.png",
      "adaptiveIcon": {
        "backgroundColor": "#3B0764",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#3B0764"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "",
      "googleWebClientId": "32346032386-92npa1nj0v043m9qukudbmaa0g0hod1p.apps.googleusercontent.com",
      "googleIosClientId": "32346032386-sckj2fmsjv4huhbv8nsoduknvotrd1p4.apps.googleusercontent.com",
      "googleAndroidClientId": "",
      "eas": {
        "projectId": "79dba00b-27b1-4813-8f20-a429e2179699"
      }
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PlayTracker to pick a player photo."
        }
      ]
    ],
    "owner": "stacktracker"
  }
}
