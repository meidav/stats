{
  "name": "playtracker",
  "version": "1.2.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/config-plugins": "~57.0.0",
    "@expo/vector-icons": "15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.5",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.25",
    "expo-apple-authentication": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:release": "EXPO_PUBLIC_API_URL=https://www.playtracker.org/api/v1 expo run:ios --configuration Release --no-bundler",
    "web": "expo start --web",
    "prebuild:ios": "expo prebuild --platform ios && (cd ios && pod install) && node scripts/patch-ios-version.js",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild": "expo prebuild && node scripts/patch-ios-version.js",
    "patch-ios-version": "node scripts/patch-ios-version.js"
  },
  "private": true
}
