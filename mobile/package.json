{
  "name": "playtracker",
  "version": "1.3.3",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "~15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native/js-polyfills": "^0.88.1",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "phosphor-react-native": "^3.0.6",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:release": "EXPO_PUBLIC_API_URL=https://www.playtracker.org/api/v1 expo run:ios --configuration Release --no-bundler",
    "web": "expo start --web",
    "prebuild:ios": "expo prebuild --platform ios && (cd ios && pod install) && node scripts/patch-ios-version.js",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild": "expo prebuild && node scripts/patch-ios-version.js",
    "patch-ios-version": "node scripts/patch-ios-version.js"
  },
  "private": true
}
