#!/usr/bin/env bash
# Blocks commits that would publish data files or secrets (this repo is public).
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=AM)
[ -z "$staged" ] && exit 0

blocked_files=$(echo "$staged" | grep -iE '\.(db|sqlite3?|bak|csv|p8|p12|pem|key|keystore|mobileprovision)$|(^|/)\.env($|\.)' | grep -v '^env\.example$' || true)
if [ -n "$blocked_files" ]; then
  echo "pre-commit: refusing to commit data/secret files:" >&2
  echo "$blocked_files" | sed 's/^/  /' >&2
  exit 1
fi

pattern='-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|[sr]k_live_[0-9A-Za-z]{10,}|whsec_[0-9A-Za-z]{10,}|gh[pousr]_[0-9A-Za-z]{30,}|sk-ant-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}|(postgres(ql)?|mysql|mongodb(\+srv)?)://[^:@/[:space:]]+:[^@[:space:]]{4,}@'
hits=$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -nE -- "$pattern" || true)
if [ -n "$hits" ]; then
  echo "pre-commit: staged changes look like they contain a secret. Move it to an env var." >&2
  echo "(bypass only if you are sure: git commit --no-verify)" >&2
  exit 1
fi
